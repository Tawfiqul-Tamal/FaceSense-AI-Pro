QWidget {
    background: #f2f4f8;
    color: #1f2c3c;
    font-family: "Segoe UI", sans-serif;
    font-size: 12px;
}

QPushButton {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0 #87a1d5, stop:1 #bfd2ff);
    border: 1px solid #9bb0cf;
    border-radius: 10px;
    color: #1f2c3c;
    padding: 10px 16px;
}

QPushButton:hover {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0 #9db2e7, stop:1 #d7e4ff);
}

QPushButton:pressed {
    background: #8aa3d0;
}

QLabel#titleLabel {
    color: #2f4d76;
    font-size: 24px;
    font-weight: 700;
}

QLabel#subtitleLabel {
    color: #4f6e91;
    font-size: 14px;
}

QLabel#valueLabel {
    color: #1f2c3c;
    font-size: 18px;
    font-weight: 600;
}

QGroupBox {
    background: #ffffff;
    border: 1px solid #d0d8e8;
    border-radius: 12px;
    margin-top: 12px;
}

QGroupBox:title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 8px 12px;
    color: #2f4d76;
}

QScrollArea {
    border: none;
}

QFrame#sidebar {
    background: #e2e8f2;
}

QMenuBar {
    background: #e2e8f2;
}

QStatusBar {
    background: #dce4ef;
}
